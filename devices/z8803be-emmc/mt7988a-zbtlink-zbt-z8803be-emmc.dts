	chosen {
		u-boot,bootconf = "config-1";
		u-boot,version = "2024.10-rc2";
		bootargs = "console=ttyS0,115200n1 loglevel=8  \t\t\t    earlycon=uart8250,mmio32,0x11000000 \t\t\t    root=PARTLABEL=rootfs rootwait \t\t\t    rootfstype=squashfs,f2fs pci=pcie_bus_perf";
	};

	memory {
		device_type = "memory";
		reg = <0x00 0x40000000 0x00 0x40000000>;
	};

	gpio-keys {
		compatible = "gpio-keys";

		reset {
			label = "reset";
			linux,code = <0x198>;
			gpios = <0x1e 0x0d 0x01>;
		};

		wps {
			label = "wps";
			linux,code = <0x211>;
			gpios = <0x1e 0x0e 0x01>;
		};
	};

	gpio-leds {
		compatible = "gpio-leds";

		red {
			label = "red";
			gpios = <0x1e 0x3e 0x00>;
			default-state = "on";
		};

		green {
			label = "green";
			gpios = <0x1e 0x3a 0x01>;
			default-state = "off";
		};

		blue {
			label = "blue";
			gpios = <0x1e 0x3c 0x01>;
			default-state = "off";
		};

		4g {
			label = "4g";
			gpios = <0x1e 0x3d 0x01>;
			default-state = "off";
		};

		4g2 {
			label = "4g2";
			gpios = <0x1e 0x35 0x01>;
			default-state = "off";
		};
	};


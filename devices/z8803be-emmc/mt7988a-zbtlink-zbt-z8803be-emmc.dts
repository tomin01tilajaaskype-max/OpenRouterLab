// SPDX-License-Identifier: GPL-2.0-or-later
/*
 * ZBT Z8803BE eMMC research DTS
 *
 * Generated from the matching eMMC reference firmware DTS and patched only
 * with the three differences observed in the running device:
 * - U-Boot environment metadata
 * - U-Boot chosen properties
 * - 1 GiB RAM size
 *
 * This is a research/validation source, not yet an upstream-ready OpenWrt DTS.
 * Do not use it to create or flash firmware until the eMMC image recipe and
 * upgrade procedure are independently verified.
 */

/dts-v1/;

/ {
	mediatek,env-offset = "0x0";
	mediatek,env-size = "0x80000";
	mediatek,env-part = "PARTUUID=42952eba-57dc-11f0-b545-ffcb189888e3";
	compatible = "zbtlink,zbt-z8803be,mt7988a-emmc\0mediatek,mt7988a";
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	model = "Zbtlink Z8803BE";

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a73";
			enable-method = "psci";
			next-level-cache = <0x02>;
			reg = <0x00>;
			clocks = <0x03 0x01 0x04 0x59 0x05 0x08 0x03 0x00 0x05 0x09>;
			clock-names = "cpu\0intermediate\0armpll\0cci\0ccipll";
			operating-points-v2 = <0x06>;
			nvmem-cells = <0x07>;
			nvmem-cell-names = "calibration-data";
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a73";
			enable-method = "psci";
			next-level-cache = <0x02>;
			reg = <0x01>;
			clocks = <0x03 0x01 0x04 0x59 0x05 0x08 0x03 0x00 0x05 0x09>;
			clock-names = "cpu\0intermediate\0armpll\0cci\0ccipll";
			operating-points-v2 = <0x06>;
			nvmem-cells = <0x07>;
			nvmem-cell-names = "calibration-data";
		};

		cpu@2 {
			device_type = "cpu";
			compatible = "arm,cortex-a73";
			enable-method = "psci";
			next-level-cache = <0x02>;
			reg = <0x02>;
			clocks = <0x03 0x01 0x04 0x59 0x05 0x08 0x03 0x00 0x05 0x09>;

			operating-points-v2 = <0x06>;
			nvmem-cells = <0x07>;
			nvmem-cell-names = "calibration-data";
		};

		cpu@3 {
			device_type = "cpu";
			compatible = "arm,cortex-a73";
			enable-method = "psci";
			next-level-cache = <0x02>;
			reg = <0x03>;
			clocks = <0x03 0x01 0x04 0x59 0x05 0x08 0x03 0x00 0x05 0x09>;

		#address-cells = <0x01>;
		#size-cells = <0x00>;
		status = "okay";
		phandle = <0x14>;

		mac@0 {
			compatible = "mediatek,eth-mac";
			reg = <0x00>;
			mac-type = "xgdm";
			phy-mode = "10gbase-kr";
			phandle = <0x38>;

			fixed-link {
				speed = <0x2710>;
				full-duplex;
				pause;
			};
		};

		mac@1 {
			compatible = "mediatek,eth-mac";
			reg = <0x01>;
			mac-type = "xgdm";
			phy-mode = "xgmii";
			phy-handle = <0x31>;
		};

		mac@2 {
			compatible = "mediatek,eth-mac";
			reg = <0x02>;
			mac-type = "xgdm";
			phy-mode = "10gbase-kr";
			managed = "in-band-status";
			sfp = <0x32>;
		};

		mdio-bus {
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			ethernet-phy@0 {
				pinctrl-names = "i2p5gbe-led";
				pinctrl-0 = <0x33>;
				reg = <0x0f>;
				compatible = "ethernet-phy-ieee802.3-c45";
				phy-mode = "xgmii";
				phandle = <0x31>;
			};

			switch@0 {
				compatible = "mediatek,mt7988";
				reg = <0x1f>;

				ports {
					#address-cells = <0x01>;
					#size-cells = <0x00>;

					port@0 {
						reg = <0x00>;
						label = "lan0";
						phy-mode = "gmii";
						phy-handle = <0x34>;
					};

					port@1 {
						reg = <0x01>;
						label = "lan1";
						phy-mode = "gmii";
						phy-handle = <0x35>;
					};

					port@2 {
						reg = <0x02>;
						label = "lan2";
						phy-mode = "gmii";
						phy-handle = <0x36>;
					};

					port@3 {
						reg = <0x03>;
						label = "lan3";
						phy-mode = "gmii";
						phy-handle = <0x37>;
					};

					port@6 {
						reg = <0x06>;
						label = "cpu";
						ethernet = <0x38>;
						phy-mode = "10gbase-kr";

						fixed-link {
							speed = <0x2710>;
							full-duplex;
							pause;
						};
					};
				};

				mdio {
					compatible = "mediatek,dsa-slave-mdio";
					#address-cells = <0x01>;
					#size-cells = <0x00>;

					switch_phy0@0 {
						compatible = "ethernet-phy-id03a2.9481";
						reg = <0x00>;
						pinctrl-names = "gbe-led";
						pinctrl-0 = <0x39>;
						nvmem-cells = <0x3a>;
						nvmem-cell-names = "phy-cal-data";
						phandle = <0x34>;
					};

					switch_phy1@1 {
						compatible = "ethernet-phy-id03a2.9481";
						reg = <0x01>;
						pinctrl-names = "gbe-led";
						pinctrl-0 = <0x3b>;
						nvmem-cells = <0x3c>;
						nvmem-cell-names = "phy-cal-data";
						phandle = <0x35>;
					};

					switch_phy2@2 {
						compatible = "ethernet-phy-id03a2.9481";
						reg = <0x02>;
						pinctrl-names = "gbe-led";
						pinctrl-0 = <0x3d>;
						nvmem-cells = <0x3e>;
						nvmem-cell-names = "phy-cal-data";
						phandle = <0x36>;
					};

					switch_phy3@3 {
						compatible = "ethernet-phy-id03a2.9481";
						reg = <0x03>;
						pinctrl-names = "gbe-led";
						pinctrl-0 = <0x3f>;
						nvmem-cells = <0x40>;
						nvmem-cell-names = "phy-cal-data";
						phandle = <0x37>;
					};

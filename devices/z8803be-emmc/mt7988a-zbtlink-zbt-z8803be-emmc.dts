		compatible = "gpio-export";
		#size-cells = <0x00>;

		4g {
			gpio-export,name = "4g";
			gpio-export,output = <0x00>;
			gpios = <0x1e 0x11 0x00>;
		};

		4g2 {
			gpio-export,name = "4g2";
			gpio-export,output = <0x00>;
			gpios = <0x1e 0x34 0x00>;
		};

		wdg {

		clock-names = "xgp1\0xgp2\0xgp3\0fe\0gp2\0gp1\0gp3\0esw\0crypto\0sgmii_tx250m\0sgmii_rx250m\0sgmii2_tx250m\0sgmii2_rx250m\0ethwarp_wocpu2\0ethwarp_wocpu1\0ethwarp_wocpu0\0top_usxgmii0_sel\0top_usxgmii1_sel\0top_sgm0_sel\0top_sgm1_sel\0top_xfi_phy0_xtal_sel\0top_xfi_phy1_xtal_sel\0top_eth_gmii_sel\0top_eth_refck_50m_sel\0top_eth_sys_200m_sel\0top_eth_sys_sel\0top_eth_xgmii_sel\0top_eth_mii_sel\0top_netsys_sel\0top_netsys_500m_sel\0top_netsys_pao_2x_sel\0top_netsys_sync_250m_sel\0top_netsys_ppefb_250m_sel\0top_netsys_warp_sel\0top_macsec_sel";

			operating-points-v2 = <0x06>;
			nvmem-cells = <0x07>;
			nvmem-cell-names = "calibration-data";
		};

		l2-cache {
			compatible = "cache";
			cache-level = <0x02>;
			phandle = <0x02>;
		};

		opp_table0 {
			compatible = "operating-points-v2";
